{
	"name": "PL_EMAIL_SEND",
	"properties": {
		"activities": [
			{
				"name": "pipeline_email_notify",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "logic_apps_body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-23.southindia.logic.azure.com:443/workflows/b8e2126d953c456d953dbc48dfa05e2c/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=FU9TfoCBWpzHAgaSWTjIUMhhHy0Mnm7VcWzxe5Nc23g",
					"body": {
						"value": "@variables('logic_apps_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "logic_apps_body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "preparing_email_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare_email_body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic_apps_body",
					"value": {
						"value": "{\n\"email_recepient\":\"@{pipeline().globalParameters.email_recepient}\",\n\"subject\":\"@{variables('email_subject')}\",\n\"body\":\"@{variables('email_body')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "preparing_email_subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().parameters.table_name} - @{pipeline().parameters.status}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email_body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "the table @{pipeline().parameters.table_name} has been ingested completely and the status is @{pipeline().parameters.status}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"table_name": {
				"type": "string"
			},
			"email_recepient": {
				"type": "string"
			},
			"status": {
				"type": "string"
			}
		},
		"variables": {
			"logic_apps_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": []
	}
}